# Copy to a private file (e.g. .env.local, not committed) and: set -a; source .env.local; set +a
# Used with monorepo docs/tools/post-leaf-cert-manifest-renew.sh — see docs/operations/tls-manifest-automation.md

# Required for signing + verify
# PRIVATE_KEY_PATH=/secure/path/pin-manifest-private.pem
# PUBLIC_KEY_HEX=<64_lowercase_hex_same_as_app_OMBIST_PIN_MANIFEST_PUBLIC_KEY_HEX>
# VALID_UNTIL=2099-12-31T23:59:59Z
# VERSION=1
# MANIFEST_OUT=/tmp/relay-pin-manifest.json

# Leaf PEM (or rely on Certbot RENEWED_LINEAGE when hook runs post-leaf script)
# LEAF_PEM=/path/to/ingress-fullchain.pem

# Optional dual-pin rotation
# NEXT_PIN=

# Optional publish after verify (example only — use credentials via your tooling, not inline secrets)
# PUBLISH_CMD=

# Optional skip when leaf pin unchanged (see tls-manifest-automation.md)
# OMBIST_SKIP_MANIFEST_IF_PIN_UNCHANGED=1
# OMBIST_MANIFEST_LAST_PIN_STATE=/var/lib/ombist/last-manifest-pin.txt
